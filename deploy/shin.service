#
# shin.service — unidad systemd para dejar el bot corriendo en un VPS.
#
# Instalación:
#   sudo cp dist/shin /opt/shin/shin
#   sudo cp .env /opt/shin/.env
#   sudo cp deploy/shin.service /etc/systemd/system/shin.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shin
#   journalctl -u shin -f        ← el log
#
# Restart=on-failure (no "always": si el bot muere por sesión caducada,
# reiniciar en bucle solo empeora el ban; con on-failure vuelve y, si vuelve
# a caer, Systemd lo frena con StartLimitBurst).
#
# MemoryMax y no MemoryLimit porque es la forma moderna; y el arranque limpio
# (Ctrl+C → cierre de la sesión, flush de SQLite, matar goroutines).
[Unit]
Description=Shin-MD Go — bot de WhatsApp (whatsmeow, cola anti-ban)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=shin
Group=shin
WorkingDirectory=/opt/shin
# La sesión y los datos viven en data/ junto al binario.
ExecStart=/opt/shin/shin --dir /opt/shin/data
EnvironmentFile=-/opt/shin/.env
Environment=PORT=3000 LOOPBACK=1

# Apagado limpio: Ctrl+C en Go cancela el contexto; 10 s de gracia.
TimeoutStopSec=10
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5

# Recursos: el bot con cola y panel no pasa de ~150 MB; 512 es holgura.
MemoryMax=512M
# Menos ruido: no heredar cosas del sistema.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/shin/data

[Install]
WantedBy=multi-user.target
